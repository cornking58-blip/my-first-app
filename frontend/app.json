{
  "expo": {
    "name": "bAIkov",
    "slug": "baikov",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "baikov",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#010203",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.baikov.herbicides"
    },
    "android": {
      "package": "com.baikov.herbicides",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#010203"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "bAIkov использует фотографию для агрономической диагностики.",
          "cameraPermission": "bAIkov использует камеру для съёмки растения или вредного объекта.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#010203",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#010203"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
